        {
          "id": "366208d5-9a19-4b57-86b6-89c210d61282",
          "name": "WeatherAPI Bulk Current Weather",
          "request": {
            "name": "WeatherAPI Bulk Current Weather",
            "description": {
              "content": "Retrieve current weather for multiple locations in a single request. Pass `q=bulk` in the query string with a JSON body containing up to 50 locations. Each location counts as 1 call. Available on Pro+, Business, and Enterprise plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "current.json"
              ],
              "hash": "bulk",
