        {
          "id": "86c34186-dad9-4799-9d69-0b66cb0ffde5",
          "name": "WeatherAPI Forecast Weather",
          "request": {
            "name": "WeatherAPI Forecast Weather",
            "description": {
              "content": "Returns weather forecast for up to 14 days (plan dependent). Includes hourly intervals, astronomy, air quality, pollen, and weather alerts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your WeatherAPI.com API key."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Location query. Accepts: city name, lat/lon, US zip, UK postcode, Canada postal code, METAR code (metar:EGLL), IATA (iata:DXB), auto:ip, IPv4/IPv6, or location ID (id:2801268)."
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "(Required) Number of forecast days (1–14)."
                },
                {
                  "disabled": false,
                  "key": "dt",
                  "value": "<date>",
                  "description": "Restrict date output in yyyy-MM-dd format."
                },
                {
                  "disabled": false,
                  "key": "unixdt",
                  "value": "<integer>",
                  "description": "Unix timestamp equivalent of `dt`. Do not pass both."
                },
                {
                  "disabled": false,
                  "key": "hour",
                  "value": "<integer>",
                  "description": "Restrict output to a specific hour (0–23) in 24-hour format."
                },
                {
                  "disabled": false,
                  "key": "alerts",
                  "value": "no",
                  "description": "Include weather alerts in Forecast API response."
                },
                {
                  "disabled": false,
                  "key": "aqi",
                  "value": "no",
                  "description": "Include Air Quality Index (AQI) data in response."
                },
                {
                  "disabled": false,
                  "key": "pollen",
                  "value": "no",
                  "description": "Include pollen data. Available on Pro+ and above."
                },
                {
                  "disabled": false,
                  "key": "tp",
                  "value": "<integer>",
                  "description": "Interval for data. Use tp=15 for 15-minute intervals (Enterprise only)."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language code for condition text. E.g.: fr, de, es, zh, ar. See full list in docs."
                },
                {
                  "disabled": false,
                  "key": "day_fields",
                  "value": "<string>",
                  "description": "Comma-separated fields to return in forecast/history day element."
                },
                {
                  "disabled": false,
                  "key": "hour_fields",
                  "value": "<string>",
                  "description": "Comma-separated fields to return in forecast/history hour element."
                },
                {
                  "disabled": false,
                  "key": "et0",
                  "value": "<string>",
                  "description": "Include evapotranspiration data. Business and Enterprise only."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
