    {
      "id": "15456db4-0369-4c95-99ab-1013f22958a6",
      "name": "Weather",
      "description": {
        "content": "Real-time and forecast weather endpoints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1f7872c6-642f-4135-8b80-096b4bbbc992",
          "name": "WeatherAPI Current / Real-time Weather",
          "request": {
            "name": "WeatherAPI Current / Real-time Weather",
            "description": {
              "content": "Returns up-to-date current weather for a given location. Data is refreshed every 10–15 minutes. Optionally includes air quality (AQI) and pollen data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "current.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your WeatherAPI.com API key."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Location query. Accepts: city name, lat/lon, US zip, UK postcode, Canada postal code, METAR code (metar:EGLL), IATA (iata:DXB), auto:ip, IPv4/IPv6, or location ID (id:2801268)."
                },
                {
                  "disabled": false,
                  "key": "aqi",
                  "value": "no",
                  "description": "Include Air Quality Index (AQI) data in response."
                },
                {
                  "disabled": false,
                  "key": "pollen",
                  "value": "no",
                  "description": "Include pollen data. Available on Pro+ and above."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language code for condition text. E.g.: fr, de, es, zh, ar. See full list in docs."
                },
                {
                  "disabled": false,
                  "key": "current_fields",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to return in the current element, e.g. temp_c,wind_mph."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
