    {
      "id": "a0d6fefd-fb09-489c-88bb-fffd51fe90c1",
      "name": "History",
      "description": {
        "content": "Historical weather data",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a3887d4a-8bc3-44b3-8e30-7abcd1f8c77e",
          "name": "WeatherAPI Historical Weather",
          "request": {
            "name": "WeatherAPI Historical Weather",
            "description": {
              "content": "Returns historical weather data for a given date on or after 1 January 2010. Includes hourly breakdown. Enterprise plan unlocks solar irradiance, wind@100m, pollen history, and evapotranspiration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "history.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your WeatherAPI.com API key."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Location query. Accepts: city name, lat/lon, US zip, UK postcode, Canada postal code, METAR code (metar:EGLL), IATA (iata:DXB), auto:ip, IPv4/IPv6, or location ID (id:2801268)."
                },
                {
                  "disabled": false,
                  "key": "dt",
                  "value": "<date>",
                  "description": "(Required) Date on or after 2010-01-01 in yyyy-MM-dd format."
                },
                {
                  "disabled": false,
                  "key": "unixdt",
                  "value": "<integer>",
                  "description": "Unix timestamp equivalent of `dt`. Do not pass both."
                },
                {
                  "disabled": false,
                  "key": "end_dt",
                  "value": "<date>",
                  "description": "End date for range (Pro+ and above). Max 30 days range. yyyy-MM-dd."
                },
                {
                  "disabled": false,
                  "key": "unixend_dt",
                  "value": "<integer>",
                  "description": "Unix timestamp equivalent of `end_dt`. Do not pass both."
                },
                {
                  "disabled": false,
                  "key": "hour",
                  "value": "<integer>",
                  "description": "Restrict output to a specific hour (0–23) in 24-hour format."
                },
                {
                  "disabled": false,
                  "key": "aqi",
                  "value": "no",
                  "description": "Include Air Quality Index (AQI) data in response."
                },
                {
                  "disabled": false,
                  "key": "pollen",
                  "value": "no",
                  "description": "Include pollen data. Available on Pro+ and above."
                },
                {
                  "disabled": false,
                  "key": "tp",
                  "value": "<integer>",
                  "description": "Interval for data. Use tp=15 for 15-minute intervals (Enterprise only)."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language code for condition text. E.g.: fr, de, es, zh, ar. See full list in docs."
                },
                {
                  "disabled": false,
                  "key": "solar",
                  "value": "<string>",
                  "description": "Include solar irradiance data in History API. Enterprise only."
                },
                {
                  "disabled": false,
                  "key": "et0",
                  "value": "<string>",
                  "description": "Include evapotranspiration data. Business and Enterprise only."
                },
                {
                  "disabled": false,
                  "key": "wind100mph",
                  "value": "<string>",
                  "description": "Include wind speed at 100m height in mph. Enterprise only."
                },
                {
                  "disabled": false,
                  "key": "wind100kph",
                  "value": "<string>",
                  "description": "Include wind speed at 100m height in kph. Enterprise only."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
